# ============================================
# PahamFin Bot Configuration
# Ganti nilai di bawah ini sebelum menjalankan
# ============================================

# === TELEGRAM ===
# Dapatkan dari @BotFather di Telegram
TELEGRAM_TOKEN=MASUKKAN_TOKEN_BOT_TELEGRAM_DISINI

# === WHATSAPP ===
# URL Webhook PHP (pastikan bisa diakses dari server ini)
WEBHOOK_URL=http://localhost/PahamFin/webhook.php

# Kunci rahasia webhook (harus sama dengan PAHAMFIN_WEBHOOK_SECRET di includes/config.php)
PAHAMFIN_WEBHOOK_KEY=UbahIniDenganKunciRahasiaPanjang
